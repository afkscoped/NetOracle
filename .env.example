APP_NAME=NetOracle
APP_ENV=development
DATABASE_PATH=./data/netoracle.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=phi3:mini,mistral:7b,llama3.1:8b
SLACK_WEBHOOK_URL=
OPENAI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
CONFIDENCE_THRESHOLD=0.60
REMEDIATION_MODE=simulation
CLOUD_PROVIDER=local

# Cloud export is disabled. Reports are saved as local JSON files in exports/.

# Data sources: simulation | csv_stream | prometheus | open5gs | upload
DATA_SOURCE_MODE=simulation
PROMETHEUS_URL=http://localhost:9090

# Open5GS integration. For Windows-to-WSL2, replace localhost with your WSL2 IP or wsl.local.
OPEN5GS_PROMETHEUS_URL=http://localhost:9090
OPEN5GS_MONGO_URI=mongodb://localhost:27017
OPEN5GS_WEBUI_URL=http://localhost:3000
OPEN5GS_POLL_INTERVAL_S=5
